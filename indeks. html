
<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>KIEROWCA - Aplikacja Trasy</title>
    <style>
        /* --- STYLES - ODPOWIADAJĄ ZA WYGLĄD APLIKACJI (Dark Theme) --- */
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            background-color: #121212;
            color: #e0e0e0;
            margin: 0;
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 16px;
            box-sizing: border-box;
        }

        .card {
            background-color: #1e1e1e;
            border-radius: 12px;
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
        }

        h1 {
            margin: 0;
            font-size: 24px;
            font-weight: 700;
            color: #ffffff;
        }

        .status-text {
            font-size: 16px;
            color: #b0b0b0;
            margin-bottom: 8px;
        }

        .route-input {
            width: 100%;
            padding: 12px;
            border-radius: 8px;
            border: 1px solid #424242;
            background-color: #2c2c2c;
            color: #ffffff;
            font-size: 16px;
            box-sizing: border-box;
            margin-bottom: 8px;
        }

        .btn {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.2s;
            box-sizing: border-box;
            text-align: center;
        }

        .btn-start {
            background-color: #0d47a1; /* Niebieski */
            color: #ffffff;
        }

        .btn-start:active {
            background-color: #1565c0;
        }

        .btn-stop {
            background-color: #c62828; /* Czerwony */
            color: #ffffff;
            margin-top: 8px;
        }

        .btn-stop:active {
            background-color: #d32f2f;
        }

        .btn:disabled {
            background-color: #424242;
            color: #757575;
            cursor: not-allowed;
        }

        .metrics-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .metric-box {
            background-color: #2c2c2c;
            border-radius: 8px;
            padding: 12px;
            display: flex;
            flex-direction: column;
        }

        .metric-value {
            font-size: 28px;
            font-weight: 700;
            color: #ffffff;
        }

        .metric-label {
            font-size: 12px;
            text-transform: uppercase;
            color: #9e9e9e;
            margin-top: 4px;
        }

        .activity-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-top: 8px;
        }

        .btn-activity {
            background-color: #424242; /* Ciemnoszare przyciski aktywności */
            color: #ffffff;
            padding: 12px;
        }

        .btn-activity:active {
            background-color: #616161;
        }
        
        #gpsStatus {
            font-size: 11px;
            color: #757575;
            text-align: center;
            margin-top: 8px;
        }
    </style>
</head>
<body>

    <!-- Sekcja Główna -->
    <div class="card">
        <h1>KIEROWCA</h1>
        <div class="status-text">Gotowy do jazdy</div>
        <input type="text" id="routeInput" class="route-input" placeholder="Wpisz trasę (np. Gądki → Poznań)" value="Gądki → Poznań">
        <button id="startBtn" class="btn btn-start" onclick="startRide()">START TRASY</button>
        <button id="stopBtn" class="btn btn-stop" onclick="stopRide()" disabled>ZAKOŃCZ TRASĘ</button>
    </div>

    <!-- Sekcja Metryk -->
    <div class="metrics-grid">
        <div class="metric-box">
            <div id="distanceVal" class="metric-value">0.00</div>
            <div class="metric-label">KM</div>
        </div>
        <div class="metric-box">
            <div id="timeVal" class="metric-value">00:00</div>
            <div class="metric-label">CZAS (MM:SS)</div>
        </div>
        <div class="metric-box">
            <div id="speedVal" class="metric-value">0</div>
            <div class="metric-label">KM/H</div>
        </div>
        <div class="metric-box">
            <div id="gpsPointsVal" class="metric-value">0</div>
            <div class="metric-label">PUNKTY GPS</div>
        </div>
    </div>

    <!-- Sekcja Czynności -->
    <div class="card">
        <div class="status-text">Czynność</div>
        <div class="activity-grid">
            <button class="btn btn-activity" onclick="logActivity('Załadunek')">📦 Załadunek</button>
            <button class="btn btn-activity" onclick="logActivity('Rozładunek')">📤 Rozładunek</button>
            <button class="btn btn-activity" onclick="logActivity('Przeładunek')">🔄 Przeładunek</button>
            <button class="btn btn-activity" onclick="logActivity('Tankowanie')">⛽ Tankowanie</button>
            <button class="btn btn-activity" onclick="logActivity('Postój')">⏸️ Postój</button>
            <button class="btn btn-activity" onclick="logActivity('Inne')">📝 Inne</button>
        </div>
    </div>
    
    <div id="gpsStatus">Brak dostępu do GPS</div>

    <script>
        /* --- JAVASCRIPT - LOGIKA APLIKACJI --- */

        // Zmienne stanu
        let watchId = null;
        let startTime = null;
        let timerInterval = null;
        let totalDistance = 0; // w metrach
        let lastPosition = null;
        let gpsPoints = 0;

        // Funkcje pomocnicze do aktualizacji interfejsu
        const el = (id) => document.getElementById(id);
        const formatNum = (num) => num.toFixed(2);
        const formatTime = (totalSeconds) => {
            const mins = Math.floor(totalSeconds / 60).toString().padStart(2, '0');
            const secs = Math.floor(totalSeconds % 60).toString().padStart(2, '0');
            return `${mins}:${secs}`;
        };

        // --- GŁÓWNE FUNKCJE KONTROLNE ---

        function startRide() {
            // 1. Reset stanu
            totalDistance = 0;
            gpsPoints = 0;
            lastPosition = null;
            el('distanceVal').innerText = formatNum(0);
            el('speedVal').innerText = 0;
            el('gpsPointsVal').innerText = 0;
            el('routeInput').disabled = true;

            // 2. Uruchom Zegar
            startTime = Date.now();
            timerInterval = setInterval(updateTimer, 1000);

            // 3. Uruchom GPS (Geolokalizacja)
            if (navigator.geolocation) {
                el('gpsStatus').innerText = "Oczekiwanie na sygnał GPS...";
                watchId = navigator.geolocation.watchPosition(
                    handlePosition, 
                    handleError, 
                    { enableHighAccuracy: true, maximumAge: 10000, timeout: 5000 }
                );
            } else {
                alert("Twoja przeglądarka nie obsługuje geolokalizacji.");
                el('gpsStatus').innerText = "Błąd GPS";
            }

            // 4. Zmień przyciski
            el('startBtn').disabled = true;
            el('stopBtn').disabled = false;
            console.log("Trasa rozpoczęta.");
        }

        function stopRide() {
            // 1. Zatrzymaj GPS
            if (watchId !== null) {
                navigator.geolocation.clearWatch(watchId);
                watchId = null;
            }

            // 2. Zatrzymaj Zegar
            if (timerInterval !== null) {
                clearInterval(timerInterval);
                timerInterval = null;
            }

            // 3. Przywróć interfejs
            el('routeInput').disabled = false;
            el('startBtn').disabled = false;
            el('stopBtn').disabled = true;
            el('gpsStatus').innerText = "Trasa zakończona.";
            console.log("Trasa zakończona.");
        }

        // --- LOGIKA ŚLEDZENIA ---

        function updateTimer() {
            const now = Date.now();
            const diff = Math.floor((now - startTime) / 1000);
            el('timeVal').innerText = formatTime(diff);
        }

        function handlePosition(position) {
            const currentPosition = {
                lat: position.coords.latitude,
                lng: position.coords.longitude
            };
            
            // Aktualizuj status GPS
            el('gpsStatus').innerText = `GPS Aktywny: ${currentPosition.lat.toFixed(4)}, ${currentPosition.lng.toFixed(4)}`;
            gpsPoints++;
            el('gpsPointsVal').innerText = gpsPoints;

            // Aktualizuj prędkość (z GPS, w m/s, * 3.6 = km/h)
            const speedKmh = position.coords.speed ? Math.round(position.coords.speed * 3.6) : 0;
            el('speedVal').innerText = speedKmh;

            // Oblicz dystans jeśli to nie pierwsza pozycja
            if (lastPosition) {
                const distanceInMeters = calculateDistance(
                    lastPosition.lat, lastPosition.lng, 
                    currentPosition.lat, currentPosition.lng
                );
                
                // Ignoruj małe przesunięcia (np. błąd GPS w miejscu)
                if (distanceInMeters > 3) {
                    totalDistance += distanceInMeters;
                    el('distanceVal').innerText = formatNum(totalDistance / 1000); // Konwersja na KM
                }
            }

            lastPosition = currentPosition;
        }

        function handleError(error) {
            console.error("Błąd GPS:", error.message);
            let msg = "Błąd GPS";
            switch(error.code) {
                case error.PERMISSION_DENIED: msg = "Brak zgody na lokalizację. Włącz w ustawieniach przeglądarki."; break;
                case error.POSITION_UNAVAILABLE: msg = "Lokalizacja niedostępna."; break;
                case error.TIMEOUT: msg = "Przekroczono czas oczekiwania na sygnał GPS."; break;
            }
            el('gpsStatus').innerText = msg;
        }

        // Wzór Haversine do obliczania dystansu między współrzędnymi
        function calculateDistance(lat1, lon1, lat2, lon2) {
            const R = 6371e3; // Promień Ziemi w metrach
            const dLat = (lat2 - lat1) * Math.PI / 180;
            const dLon = (lon2 - lon1) * Math.PI / 180;
            const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                      Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                      Math.sin(dLon / 2) * Math.sin(dLon / 2);
            const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
            return R * c; // Dystans w metrach
        }

        // --- FUNKCJE POMOCNICZE ---

        function logActivity(type) {
            const route = el('routeInput').value;
            const timestamp = new Date().toLocaleTimeString();
            const message = `Czynność: ${type}, Trasa: "${route}", Czas: ${timestamp}`;
            console.log(message);
            // W przyszłości możesz tu dodać wysyłanie do bazy danych lub zapis do pliku
            alert(type + " Zarejestrowana w logach");
        }

    </script>
</bod</html>.
